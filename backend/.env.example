# Copie este arquivo para ".env" e troque o valor abaixo.
# O .env NÃO vai para o GitHub (está no .gitignore).

# Chave usada para assinar os tokens JWT (mínimo 32 caracteres).
# Para gerar uma aleatória: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-com-32-ou-mais-caracteres

# Porta do servidor (opcional, padrão 3001)
PORT=3001
